generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  MODEL
  DATASET
  SERVICE
  LIBRARY
}

enum HostingModel {
  SAAS_API
  SELF_HOSTED
  EMBEDDED_IN_APP
}

enum NetworkDependency {
  AIR_GAPPED
  HYBRID
  FULLY_CONNECTED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum AssetStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  DEPLOYED
  RETIRED
}

enum SourceFramework {
  NIST_AI_RMF
  EU_AI_ACT
  OWASP_LLM_TOP10
  OWASP_MCP_TOP10
}

enum FrameworkStatus {
  DRAFT
  RELEASED
}

enum CrosswalkRelationship {
  EQUIVALENT
  RELATED
  BROADER
  NARROWER
}

enum EuAiActRiskTier {
  UNACCEPTABLE
  HIGH
  LIMITED
  MINIMAL
}

enum RiskStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  ACCEPTED
}

enum StrideAiCategory {
  MODEL_IMPERSONATION
  DATA_MODEL_POISONING
  PROVENANCE_LOSS
  MODEL_INVERSION
  RESOURCE_EXHAUSTION
  ALIGNMENT_BYPASS
}

enum ControlImplementationStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
}

enum Role {
  ADMIN
  RISK_OWNER
  APPROVER
  VIEWER
}

enum AttachmentEntity {
  RISK
  CONTROL
  MODEL_CARD
  AI_SYSTEM
  PROJECT
}

// Evidence files attached to a governance record. The bytes live on disk under
// ATTACHMENTS_DIR keyed by `storageKey`; this row is the metadata + ownership.
model Attachment {
  id           String           @id @default(cuid())
  entityType   AttachmentEntity
  entityId     String
  filename     String
  contentType  String
  size         Int
  storageKey   String           @unique
  description  String?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([entityType, entityId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  role                Role                 @default(VIEWER)
  active              Boolean              @default(true)
  // Bumped on password change / "log out everywhere" / admin deactivation —
  // every access token that carries an older value is rejected (TOKEN_STALE).
  tokenVersion        Int                  @default(0)
  mustChangePassword  Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  // TOTP (RFC 6238) second factor. `totpSecret` is set the moment enrolment
  // starts; `totpEnabledAt` stays null until a first code is confirmed and only
  // then is a code demanded at login.
  totpSecret          String?
  totpEnabledAt       DateTime?
  createdAt           DateTime             @default(now())
  sessions            Session[]
  totpRecoveryCodes   TotpRecoveryCode[]
  attachments         Attachment[]
  assets              AIAsset[]            @relation("AssetCreator")
  approvals           GovernanceWorkflow[] @relation("WorkflowApprover")
  auditLogs           AuditLog[]           @relation("AuditActor")
  projects            Project[]            @relation("ProjectCreator")
  risks               Risk[]               @relation("RiskCreator")
}

// Single-use TOTP recovery codes. Only the SHA-256 hash is stored; the plaintext
// set is shown to the user exactly once, at enrolment.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per active refresh token. The raw token lives only in the client's
// httpOnly cookie; we store its SHA-256 hash. Rotated on every /auth/refresh.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  beforeJson Json?
  afterJson  Json?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([timestamp])
}

model AIAsset {
  id                         String               @id @default(cuid())
  name                       String
  version                    String
  type                       AssetType
  supplier                   String
  provider                   String?
  hostingModel               HostingModel
  networkDependency          NetworkDependency    @default(FULLY_CONNECTED)
  license                    String?
  dataClassificationTouched  String?
  trainingDataProvenance     String?
  downstreamConsumers        String?
  sourceUrl                  String?
  status                     AssetStatus          @default(DRAFT)
  createdById                String
  createdBy                  User                 @relation("AssetCreator", fields: [createdById], references: [id])
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  riskLinks                  AssetRisk[]
  projectLinks               ProjectAsset[]
  parentDependencies         AssetDependency[]    @relation("AssetDependencyParent")
  childDependencies          AssetDependency[]    @relation("AssetDependencyChild")
  workflow                   GovernanceWorkflow[]
  recertificationSchedule    RecertificationSchedule?
  modelCard                  ModelCard?

  @@index([status])
  @@index([type])
  @@index([hostingModel])
  @@index([networkDependency])
}

model Risk {
  id                    String           @id @default(cuid())
  sourceFramework       SourceFramework
  sourceCategoryId      String
  euAiActRiskTier       EuAiActRiskTier?
  strideAiCategory      StrideAiCategory?
  atlasTechnique        String?
  atlasMitigations      String[]         @default([])
  description           String
  likelihood            Int
  impact                Int
  inherentRiskScore     Int
  residualRiskScore     Int?
  treatmentPlan         String?
  owner                 String?
  dueDate               DateTime?
  status                RiskStatus       @default(OPEN)
  archived              Boolean          @default(false)
  createdById           String
  createdBy             User             @relation("RiskCreator", fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  controlLinks          RiskControl[]
  assets                AssetRisk[]
  projects              ProjectRisk[]
  frameworkCategory     FrameworkCategory @relation(fields: [sourceFramework, sourceCategoryId], references: [framework, categoryId])

  @@index([sourceFramework])
  @@index([status])
  @@index([archived])
  @@index([createdById])
  @@index([inherentRiskScore])
}

model ModelCard {
  id                          String   @id @default(cuid())
  assetId                     String   @unique
  asset                       AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  approach                    String?
  task                        String?
  architectureFamily          String?
  modelArchitecture           String?
  datasetsDescription         String?
  inputsDescription           String?
  outputsDescription          String?
  intendedUsers               String?
  useCases                    String?
  technicalLimitations        String?
  performanceTradeoffs        String?
  ethicalConsiderations       String?
  fairnessAssessments         String?
  environmentalConsiderations String?
  performanceMetrics          Json?
  metrics                     ModelCardMetric[]
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model ModelCardMetric {
  id          String    @id @default(cuid())
  modelCardId String
  modelCard   ModelCard @relation(fields: [modelCardId], references: [id], onDelete: Cascade)
  metricName  String
  metricValue Float
  slice       String?
  recordedAt  DateTime  @default(now())

  @@index([modelCardId])
  @@index([metricName])
}

model AssetRisk {
  id       String   @id @default(cuid())
  assetId  String
  asset    AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  riskId   String
  risk     Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  linkedAt DateTime @default(now())

  @@unique([assetId, riskId])
  @@index([riskId])
}

model AssetDependency {
  id            String  @id @default(cuid())
  parentAssetId String
  parentAsset   AIAsset @relation("AssetDependencyParent", fields: [parentAssetId], references: [id], onDelete: Cascade)
  childAssetId  String
  childAsset    AIAsset @relation("AssetDependencyChild", fields: [childAssetId], references: [id], onDelete: Cascade)

  @@unique([parentAssetId, childAssetId])
  @@index([childAssetId])
}

model Project {
  id            String         @id @default(cuid())
  name          String
  description   String?
  businessOwner String?
  status        ProjectStatus  @default(ACTIVE)
  createdById   String
  createdBy     User           @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assetLinks    ProjectAsset[]
  riskLinks     ProjectRisk[]

  @@index([status])
}

model ProjectAsset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId   String
  asset     AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  linkedAt  DateTime @default(now())

  @@unique([projectId, assetId])
  @@index([assetId])
}

model ProjectRisk {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  riskId    String
  risk      Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  linkedAt  DateTime @default(now())

  @@unique([projectId, riskId])
  @@index([riskId])
}

model Control {
  id              String          @id @default(cuid())
  name            String
  mappedFramework SourceFramework
  mappedControlId String
  description     String?
  archived        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  links           RiskControl[]

  @@unique([mappedFramework, mappedControlId])
  @@index([archived])
}

model RiskControl {
  id                   String                      @id @default(cuid())
  riskId               String
  risk                 Risk                        @relation(fields: [riskId], references: [id], onDelete: Cascade)
  controlId            String
  control              Control                     @relation(fields: [controlId], references: [id], onDelete: Restrict)
  implementationStatus ControlImplementationStatus @default(NOT_STARTED)
  evidenceNotes        String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([riskId, controlId])
  @@index([controlId])
}

model GovernanceWorkflow {
  id           String      @id @default(cuid())
  assetId      String
  asset        AIAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromStatus   AssetStatus
  toStatus     AssetStatus
  stepIndex    Int         @default(0)
  requiredRole Role?
  approvedById String
  approvedBy   User        @relation("WorkflowApprover", fields: [approvedById], references: [id])
  timestamp    DateTime    @default(now())
  comments     String?

  @@index([assetId])
  @@index([timestamp])
}

model RecertificationSchedule {
  id          String   @id @default(cuid())
  assetId     String   @unique
  asset       AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cadenceDays Int
  nextDueDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FrameworkCategory {
  id          String          @id @default(cuid())
  framework   SourceFramework
  categoryId  String
  name        String
  description String
  risks       Risk[]

  @@unique([framework, categoryId])
  @@index([framework])
}

model EuAiActRiskTierReference {
  id          String          @id @default(cuid())
  tier        EuAiActRiskTier @unique
  name        String
  description String
}

// Static lookup: a framework category (OWASP LLM Top 10 or OWASP MCP Top 10) ->
// its STRIDE-AI category, MITRE ATLAS technique(s), and suggested ATLAS
// mitigation(s). Auto-populates Risk.strideAiCategory / Risk.atlasTechnique /
// Risk.atlasMitigations when a risk is linked to a category that has a row.
// Seeded as reference data; every value is a default, not a lock — all stay
// editable on the risk.
model FrameworkThreatMapping {
  id               String            @id @default(cuid())
  framework        SourceFramework
  categoryId       String
  strideAiCategory StrideAiCategory?
  atlasTechniques  String[]          @default([])
  atlasMitigations String[]          @default([])

  @@unique([framework, categoryId])
  @@index([framework])
}

// A relationship between a category in one framework and a category in another
// (e.g. OWASP MCP Top 10 MCP06 <-> OWASP LLM Top 10 LLM01). Seeded reference data,
// stored in both directions so either side can be looked up. There is no official
// OWASP crosswalk; `rationale` records why we assert each link.
model FrameworkCrosswalk {
  id             String                @id @default(cuid())
  fromFramework  SourceFramework
  fromCategoryId String
  toFramework    SourceFramework
  toCategoryId   String
  relationship   CrosswalkRelationship
  rationale      String?

  @@unique([fromFramework, fromCategoryId, toFramework, toCategoryId])
  @@index([fromFramework, fromCategoryId])
}

// One row per framework: the exact revision/edition in use, whether it is a
// draft, and where it came from. The UI badges drafts; exports cite the revision.
model FrameworkMeta {
  id          String          @id @default(cuid())
  framework   SourceFramework @unique
  title       String
  revision    String
  status      FrameworkStatus @default(RELEASED)
  sourceUrl   String
  licenseNote String?
}

// Canonical list of MITRE ATLAS techniques offered for Risk.atlasTechnique.
model AtlasTechniqueReference {
  id   String @id @default(cuid())
  name String @unique
}

// Canonical list of MITRE ATLAS mitigations offered for Risk.atlasMitigations —
// the remediation-side counterpart of AtlasTechniqueReference. `name` is the
// full "AML.Mxxxx — Title" label; each entry in Risk.atlasMitigations must match one.
model AtlasMitigationReference {
  id   String @id @default(cuid())
  name String @unique
}
