DATABASE_URL="postgresql://aibom:aibom@127.0.0.1:55432/aibom?schema=public"
# Required. Generate a strong value: openssl rand -hex 32
JWT_SECRET="change-this-in-development"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Set when running behind a reverse proxy: "1" for one hop, or a trusted subnet.
# TRUST_PROXY=1
# Initial admin account (seed time only — read by prisma:seed:reference).
# scripts/setup.sh prompts for these; set them here to seed non-interactively.
# ADMIN_EMAIL defaults to admin@example.com; a blank ADMIN_PASSWORD generates a
# random one and prints it. Setting ADMIN_PASSWORD on a later seed run resets it.
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Admin User
# ADMIN_PASSWORD=
